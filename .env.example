# Local native Postgres (no Docker). Copy to .env; never commit .env.
DATABASE_URL=postgres://localhost:5432/asterism

# Stellar TESTNET only (mainnet is not supported). Values confirmed in docs/deploy-testnet.md.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Name of a Stellar CLI identity (`stellar keys`). The secret key is stored by the CLI, never in this repo.
STELLAR_SOURCE_ACCOUNT=asterism-deployer
