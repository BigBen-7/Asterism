# Local native Postgres (no Docker). Copy to .env; never commit .env.
DATABASE_URL=postgres://localhost:5432/asterism

# Stellar TESTNET only (mainnet is not supported). Values confirmed in docs/deploy-testnet.md.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Name of a Stellar CLI identity (`stellar keys`). The secret key is stored by the CLI, never in this repo.
STELLAR_SOURCE_ACCOUNT=asterism-deployer

# Indexer
# Contract id printed by `just deploy-testnet`.
REGISTRY_CONTRACT_ID=
# Ledger the contract was deployed in. Required on the first run (no saved cursor);
# it must be inside the RPC's event retention window (see services/indexer/README.md).
INDEXER_START_LEDGER=
INDEXER_POLL_SECS=5

# API
# Contract id of the credentials contract (deployed on testnet).
CREDENTIALS_CONTRACT_ID=
# Base URL of the verifier page used in verification links.
VERIFY_BASE_URL=http://localhost:3000
API_BIND=127.0.0.1:8080

# Web app (apps/web-credentials/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_CREDENTIALS_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
